    ["arm64,8.5"]="$BASE_URL/herd-lite/linux/arm64/8.5/php"
)

php_url_for_version(){
  local version=$1
  local arch

  case "$(uname -m)" in
    x86_64|amd64) arch="x86_64" ;;
    aarch64|arm64) arch="arm64" ;;
    *)
      error "Arquitetura não suportada: $(uname -m)."
      return 1
      ;;
  esac

  local php_url="${php_urls["$arch,$version"]:-}"
  if [ -z "$php_url" ]; then
    error "Versão do PHP não suportada: $version."
    return 1
  fi

  printf '%s' "$php_url"
}

install_php(){
  local version=$1
  local php_url

  php_url=$(php_url_for_version "$version") || return 1

  local_info "Downloading PHP $version binary…  \n"
  download_with_spinner "$php_url" "$PHP_BIN" || return 1

  info "Downloading cacert.pem…  "
  download_with_spinner "https://curl.se/ca/cacert.pem" "$INSTALL_DIR/cacert.pem" || return 1

  if [ ! -f "$INSTALL_DIR/php.ini" ]; then
    touch "$INSTALL_DIR/php.ini" || return 1

    {
      echo "curl.cainfo=$INSTALL_DIR/cacert.pem"
      echo "openssl.cafile=$INSTALL_DIR/cacert.pem"
      echo "pcre.jit=0"
    } >> "$INSTALL_DIR/php.ini"
  fi
}

install_composer(){
  local_info "Downloading Composer binary…  "
  download_with_spinner "$BASE_URL/herd-lite/composer" "$COMPOSER_BIN"
}

install_laravel(){
  info "Downloading Laravel Installer…  "
  download_with_spinner "$BASE_URL/resources/laravel" "$LARAVEL_BIN"
}

install_herd(){
  local version=$1
  local resp

  if ! mkdir -p "$INSTALL_DIR"; then
    error "Não foi possível criar $INSTALL_DIR."
    exit 1
  fi

  install_php "$version" || exit 1

  success "Great Job !!!! \n"
  local_question " you wish install composer and laravel installer ?\n"
  read -r resp
  if [ "$resp" = "s" ] || [ "$resp" = "S" ] || [ "$resp" = "y" ] || [ "$resp" = "Y" ]; then
    install_composer || exit 1
    install_laravel || exit 1
  fi

  adjust_path
}

